# Copy to .env and fill in. Nothing here is secret except the TURN credential.

PORT=3000

# Public IP of the machine running the SFU. Browsers connect to this address
# for media, so it must be reachable from the internet (not a private 10.x address).
ANNOUNCED_IP=203.0.113.10

# UDP port range handed to mediasoup workers. Open this range in the cloud
# firewall AND the OS firewall. 10,000 ports is plenty for a demo box.
RTC_MIN_PORT=40000
RTC_MAX_PORT=49999

# One worker per CPU core is the usual rule. Leave blank to auto-detect.
NUM_WORKERS=

# Optional: Redis for room membership shared across signaling nodes.
# Leave blank to use the in-memory registry (single process).
REDIS_URL=

# TURN server handed to clients (your own coturn). Leave TURN_URL blank to skip.
TURN_URL=turn:203.0.113.10:3478
TURN_USER=demo
TURN_PASS=change-me

# Log level for mediasoup workers: debug | warn | error | none
MEDIASOUP_LOG_LEVEL=warn
