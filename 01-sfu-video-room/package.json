{
  "name": "sfu-video-room",
  "version": "0.1.0",
  "description": "Multi-party video room on a mediasoup SFU: simulcast, active-speaker detection, Redis-backed room state, reconnect-safe signaling.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "lint": "node --check src/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "mediasoup": "^3.14.0",
    "socket.io": "^4.7.5"
  },
  "license": "MIT"
}
